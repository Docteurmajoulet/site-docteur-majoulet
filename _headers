# ==============================================================

# ---------- En-têtes globaux (toutes les routes) ----------
/*
  # --- Sécurité transport ---
  # HSTS : force HTTPS pendant 2 ans, sur tous sous-domaines, éligible preload list.
  # ⚠️ Ne pas activer preload tant que le domaine n'est pas stable en HTTPS partout.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # --- Anti-MIME sniffing / anti-clickjacking / isolation ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

  # --- Permissions-Policy : coupe capteurs sensibles non utilisés ---
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()

  # --- Content-Security-Policy ---
  # Phase 4.2 : Montserrat self-hosted → plus besoin d'autoriser fonts.googleapis.com / fonts.gstatic.com.
  # Autorise : doctolib.fr (CTA sortant), google.com/maps (iframe contact), images HTTPS (schémas JSON-LD).
  # 'unsafe-inline' pour <style>/<script> reste nécessaire : JS et CSS sont inline dans le HTML.
  # TODO : externaliser CSS/JS et supprimer 'unsafe-inline' (recommandation OWASP) — Phase 5.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; frame-src https://www.google.com https://www.doctolib.fr; connect-src 'self'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# ---------- Cache : assets versionnables (images, fonts) ----------
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache dédié : /fonts/ et /img/ (Phase 4.2 & 4.3) ----------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/img/*
  Cache-Control: public, max-age=31536000, immutable
/img/icons/*
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache : HTML (revalidation systématique) ----------
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Fichiers de découverte (sitemap, robots, llms) ----------
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
