# Sécurité HTTP, confidentialité, mise en cache
# Référence : https://docs.netlify.com/routing/headers/
# ==============================================================

# ---------- En-têtes globaux (toutes les routes) ----------
/*
  # --- Sécurité transport ---
  # HSTS : force HTTPS pendant 2 ans, sur tous sous-domaines, éligible preload list.
  # ⚠️ Ne pas activer preload tant que le domaine n'est pas stable en HTTPS partout.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # --- Anti-MIME sniffing / anti-clickjacking / isolation ---
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

  # --- Permissions-Policy : coupe capteurs sensibles non utilisés ---
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()

  # --- Content-Security-Policy ---
  # Phase 4.2 : Montserrat self-hosted → plus besoin d'autoriser fonts.googleapis.com / fonts.gstatic.com.
  # Autorise : doctolib.fr (CTA sortant), google.com/maps (iframe contact), images HTTPS (schémas JSON-LD).
  # CSP-2026-08-25 : plus de 'unsafe-inline' pour les scripts. JS externe (/nav.js) + un seul script inline,
  #   identique sur toutes les pages et autorisé par son hash :
  #   <script>document.documentElement.classList.add('js');</script>  → sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=
  #   ⚠️ Ne pas modifier ce script inline (ni ajouter d'autre script inline) sans recalculer le hash ici,
  #   sinon le script est bloqué (le contenu reste visible : filet CSS pour les sections .fade-in de la home).
  #   Les blocs <script type="application/ld+json"> ne sont pas exécutés : hors champ de script-src.
  # CSS-2026-08-29 : style-src 'self' — plus aucun attribut style= ni <style> dans les pages (classes utilitaires en fin de main.css).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self'; font-src 'self'; img-src 'self' data: https:; frame-src https://www.google.com https://www.doctolib.fr; connect-src 'self'; object-src 'none'; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# ---------- Cache : assets versionnables (images, fonts) ----------
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.avif
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache dédié : /fonts/ et /img/ (Phase 4.2 & 4.3) ----------
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/img/*
  Cache-Control: public, max-age=31536000, immutable
/img/icons/*
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache : CSS / JS versionnés (?v=… bumpé par chaque lot — CSP-2026-08-25) ----------
# ⚠️ Toute modification de main.css ou nav.js doit s'accompagner d'un nouveau ?v= dans les pages,
#    sinon les visiteurs gardent l'ancien fichier jusqu'à un an.
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# ---------- Cache : HTML (revalidation systématique) ----------
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# ---------- Fichiers de découverte (sitemap, robots, llms) ----------
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
